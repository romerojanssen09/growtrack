							</a>
							<ul class="dropdown-menu dropdown-menu-end shadow-gt-lg border border-gt-navy/10 rounded-xl p-1.5">
								@{
									var userId = "0";
									if (User.FindFirstValue(ClaimTypes.Role) == "Staff")
									{
										userId = User.FindFirstValue("BOId");
									}
									else
									{
										userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
									}
								}
								@if (User.FindFirstValue(ClaimTypes.Role) != "Admin")
								{
									<li><a class="dropdown-item rounded-lg px-3.5 py-2 text-sm" asp-action="@userId" asp-controller="BusinessProfile"><i class="fas fa-store me-2"></i>My Marketplace</a></li>
								}
								@if (User.FindFirstValue(ClaimTypes.Role) == "BusinessOwner")
								{
									<li><a class="dropdown-item rounded-lg px-3.5 py-2 text-sm" asp-action="Index" asp-controller="Profile"><i class="fas fa-user me-2"></i>Profile</a></li>
								}
								<li><a class="dropdown-item rounded-lg px-3.5 py-2 text-sm" asp-action="Settings" asp-controller="Profile"><i class="fas fa-cog me-2"></i>Settings</a></li>
								<li><hr class="dropdown-divider my-1 opacity-15"></li>
								<li>
									<form asp-controller="Home" asp-action="Logout" method="post" class="m-0">
										<button type="submit" class="dropdown-item rounded-lg px-3.5 py-2 text-sm text-danger w-full text-left">
											<i class="fas fa-sign-out-alt me-2"></i>Logout
										</button>
									</form>
								</li>
							</ul>
						</div>
						<div class="dropdown notification-dropdown">
							<a class="nav-link position-relative notification-icon inline-flex items-center justify-center w-10 h-10 rounded-xl hover:bg-gt-secondary/70 transition-colors" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
								<i class="fas fa-bell text-base text-gt-navy"></i>
								<span class="position-absolute top-1.5 end-1.5 translate-middle badge rounded-pill notification-badge d-none bg-gt-accent text-white text-[10px] px-1.5 py-0.5">0</span>
							</a>
							<div class="dropdown-menu dropdown-menu-end notification-menu p-0 shadow-gt-lg border border-gt-navy/10 rounded-2xl overflow-hidden" style="width: 380px; max-height: 460px; overflow-y: auto;">
								<div class="notification-header d-flex justify-content-between align-items-center px-4 py-3 border-bottom bg-gt-secondary/50">
									<h6 class="m-0 font-display font-bold text-sm text-gt-navy">Notifications</h6>
									<a href="#" class="mark-all-read-btn text-xs font-semibold text-gt-accent hover:underline text-decoration-none">Mark all read</a>
								</div>
								<div class="notification-list divide-y divide-gt-navy/5">
									<div class="text-center py-6">
										<div class="spinner-border spinner-border-sm text-primary" role="status">
											<span class="visually-hidden">Loading...</span>
										</div>
										<p class="text-muted text-xs mt-2 mb-0">Loading notifications...</p>
									</div>
								</div>
								
								<!-- Quick navigation for admins -->
								@if (User.IsInRole("Admin"))
								{
									<div class="p-2.5 border-top bg-gt-bg/60">
										<div class="d-flex justify-content-center">
											<div class="btn-group btn-group-sm">
												<a href="@Url.Action("BusinessOwners", "Admin")" class="btn btn-outline-primary">
													<i class="bi bi-people"></i> Business Owners
												</a>
												<a href="@Url.Action("MarketplaceApproval", "Admin")" class="btn btn-outline-info">
													<i class="bi bi-shop"></i> Marketplace
												</a>
												<a href="@Url.Action("BOApproval", "Admin")" class="btn btn-outline-secondary">
													<i class="bi bi-check-circle"></i> Approvals
												</a>
											</div>
										</div>
									</div>
								}
								
								<div class="notification-footer p-2.5 text-center border-top bg-white">
									<a href="/Notifications" class="btn btn-sm btn-secondary w-100 rounded-lg font-medium">View All Notifications</a>
								</div>
							</div>
						</div>
						@if (!User.IsInRole("Admin"))
						{
							var accessLevelClaim = User.FindFirstValue("AccessLevel");
							var staffAccessLevel = !string.IsNullOrEmpty(accessLevelClaim) &&
							Enum.TryParse<StaffAccessLevel>(accessLevelClaim, out var level) ? level : StaffAccessLevel.None;

							@if (User.IsInRole("BusinessOwner") || staffAccessLevel.HasFlag(StaffAccessLevel.Chat))
							{
								<a class="nav-link position-relative chat-icon inline-flex items-center justify-center w-10 h-10 rounded-xl hover:bg-gt-secondary/70 transition-colors" asp-action="Index" asp-controller="Chat" title="Chat">
									<i class="fas fa-message text-base text-gt-navy"></i>
									<span class="position-absolute top-1.5 end-1.5 translate-middle badge rounded-pill chat-badge d-none bg-gt-accent text-white text-[10px] px-1.5 py-0.5">0</span>
								</a>
							}
						}
					}
					else
					{
						<a asp-controller="Login" asp-action="Login" class="inline-flex items-center justify-center px-4 py-2 rounded-xl border border-gt-navy/20 hover:border-gt-accent text-gt-navy hover:text-gt-accent text-sm font-semibold no-underline transition-all auth-btn">Login</a>
						<a asp-controller="Register" asp-action="Register" class="inline-flex items-center justify-center px-5 py-2 rounded-xl bg-gt-accent hover:bg-gt-accentHover text-white text-sm font-semibold shadow-sm hover:shadow-md no-underline transition-all auth-btn">Sign Up</a>
					}
				</div>
			</div>
		</div>
	</nav>

