	<script>
		$(document).ready(function() {
		   console.log('Initializing SignalR connection...');

		   // SignalR connection with logging
		   const connection = new signalR.HubConnectionBuilder()
			   .withUrl("/realtimehub")
			   .configureLogging(signalR.LogLevel.Information)
			   .build();

		   // Set up connection event handlers for debugging
		   connection.onclose(error => {
			   console.log('SignalR connection closed', error);
		   });

		   connection.onreconnecting(error => {
			   console.log('SignalR reconnecting', error);
		   });

		   connection.onreconnected(connectionId => {
			   console.log('SignalR reconnected with ID:', connectionId);
		   });

			// Handler for notifications
			connection.on("ReceiveNotification", function(title, message) {
				console.log('Notification received:', title, message);

				// Create a unique ID for the toast
				const toastId = `toast-${Date.now()}`;

				// Create and append the toast
				const toast = `
					<div id="${toastId}" class="toast align-items-center text-white bg-info border-0" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="3000" data-bs-autohide="true">
						<div class="d-flex">
							<div class="toast-body">
								<strong>${title}</strong>: ${message}
							</div>
							<div class="me-2 m-auto" style="cursor: pointer; font-size: 1.25rem;" onclick="document.getElementById('${toastId}').remove()">×</div>
						</div>
					</div>`;
				$('.toast-container').append(toast);

				// Initialize and show the toast using Bootstrap's JS API
				const toastElement = document.getElementById(toastId);
				const bootstrapToast = new bootstrap.Toast(toastElement);
				bootstrapToast.show();
			});

		   // Start the connection
		   connection.start().then(function () {
			   console.log('SignalR Connected successfully');

			   // If user is a staff member, join a group with their ID for targeted updates
		@if (User.IsInRole("Staff"))
		{
			<text>
						const staffId = '@User.FindFirstValue(ClaimTypes.NameIdentifier)';
						console.log('Current staff ID:', staffId);

						if (staffId) {
							console.log('Attempting to join staff group:', 'staff_' + staffId);
							connection.invoke("JoinStaffGroup", staffId)
								.then(() => {
									console.log('Successfully joined staff group:', 'staff_' + staffId);
								})
								.catch(function (err) {
									console.error('Error joining staff group:', err.toString());
								});
						}
			</text>
		}
		   }).catch(function (err) {
			   console.error('SignalR Connection Error:', err.toString());
		   });

		   // Listen for direct access level changes
		   connection.on("AccessLevelChanged", function (staffId, previous, added, removed) {
				console.log('Received AccessLevelChanged event for staff ID:', staffId);
				console.log('Previous access levels:', previous);
				console.log('Added access levels:', added);
				console.log('Removed access levels:', removed);

				// Get the current user's ID
				const currentUserId = '@User.FindFirstValue(ClaimTypes.NameIdentifier)';
				console.log('Current user ID:', currentUserId);

				// Only refresh if this notification is for the current user
				if (currentUserId === staffId.toString()) {
					console.log('Access level changed for current user, refreshing claims...');
					refreshUserClaims(staffId, previous, added, removed);
				}
		   });

		   // Helper function to refresh user claims
		   function refreshUserClaims(staffId, previous, added, removed) {
				// Get the anti-forgery token
				const token = $('input[name="__RequestVerificationToken"]').val();
				console.log('CSRF Token found:', !!token);

				$.ajax({
					url: '/Dashboard/RefreshClaims/',
					type: 'POST',
					headers: {
						'RequestVerificationToken': token
					},
					success: function(response) {
						console.log('Claims refreshed successfully:', response);
						console.log('refreshUserClaims function called');
						console.log('Previous access levels:', previous);
						console.log('Added access levels:', added);
						console.log('Removed access levels:', removed);
						if(response.success){
							// Get access level details from the response
							console.log('Access level update response:', response);

							// Create HTML content for the notification
							let htmlContent = '<div style="font-size: 1.1em; margin: 15px 0;">Your access permissions have been updated by the business owner.</div>';

							// Add Current Access Levels section
							htmlContent += '<div style="margin-top: 15px;">';
							htmlContent += '<h4 style="color: #3498db; margin-bottom: 10px;">Your Access Levels:</h4>';
							htmlContent += '<div style="background: #f8f9fa; padding: 10px; border-radius: 5px;">';
							htmlContent += '<ul>';

							// Get access level from response
							const accessLevels = response.accessLevel.split(', ');

							// Display current access levels
							if (accessLevels && accessLevels.length > 0) {
								accessLevels.forEach(function(level) {
									// Check if this level was newly added
									if (added && Array.isArray(added) && added.includes(level)) {
										htmlContent += `<li class="text-success">${level} <span class="badge bg-success">New</span></li>`;
									} else {
										htmlContent += `<li>${level}</li>`;
									}
								});
							} else {
								htmlContent += '<li>No access permissions</li>';
							}

							// Display removed access levels if any
							if (removed && Array.isArray(removed) && removed.length > 0) {
								removed.forEach(function(level) {
									htmlContent += `<li class="text-danger"><del>${level}</del> <span class="badge bg-danger">Removed</span></li></li>`;
								});
							}

							htmlContent += '</ul>';
							htmlContent += '</div>'; // Close current access list div
							htmlContent += '</div>'; // Close current access section div


							// Add action button info
							htmlContent += '<div style="background: #f8f9fa; padding: 10px; border-radius: 5px; margin-top: 15px; text-align: center;">';
							htmlContent += 'Click <b>Apply Changes</b> to refresh the page and see your new permissions.';
							htmlContent += '</div>';

							// Show the SweetAlert with the detailed information
							Swal.fire({
								title: '<strong>Warning: Access Levels Changed</strong>',
								html: htmlContent,
								icon: 'info',
								confirmButtonText: 'Apply Changes',
								confirmButtonColor: '#3085d6',
								allowOutsideClick: false,
								width: '600px'
							}).then((result) => {
								if (result.isConfirmed) {
									// Refresh the page to apply the new permissions
									location.reload();
								}
							});

						}
					},
					error: function(xhr) {
						console.error('Failed to refresh claims:', xhr);

						// Show error notification
						Swal.fire({
							title: 'Error',
							text: 'Failed to refresh your access permissions. Please try refreshing the page manually.',
							icon: 'error',
							confirmButtonText: 'Refresh Now',
							showCancelButton: true,
							cancelButtonText: 'Later'
						}).then((result) => {
							if (result.isConfirmed) {
								location.reload();
							}
						});
					}
				});
		   }

		   // Notification and Chat functionality
		   if (document.body.classList.contains('user-authenticated')) {
			   // Load notification counts on page load
			   loadNotificationCount();
			   loadChatCount();
			   
			   // Load notifications for dropdown
			   $('.notification-icon').on('click', function() {
				   loadNotifications();
			   });
			   
			   // Mark all notifications as read
			   $('.mark-all-read-btn').on('click', function(e) {
				   e.preventDefault();
				   markAllNotificationsAsRead();
			   });
			   
			   // Set up handler for notification count updates
			   window.updateNavbarNotificationCount = function(count) {
				   const badge = $('.notification-badge');
				   if (count > 0) {
					   badge.text(count).removeClass('d-none');
				   } else {
					   badge.addClass('d-none');
				   }
			   };
			   
			   // Set up handler for chat count updates
			   window.updateNavbarChatCount = function(count) {
				   const badge = $('.chat-badge');
				   if (count > 0) {
					   badge.text(count).removeClass('d-none');
				   } else {
					   badge.addClass('d-none');
				   }
			   };
			   
			   // SignalR handlers for real-time updates
			   connection.on("ReceivePrivateNotification", function(title, message, notificationId, url, type) {
				   // Show toast notification
				   const toastId = `toast-${Date.now()}`;
				   const toast = `
					   <div id="${toastId}" class="toast align-items-center text-white bg-info border-0" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="5000" data-bs-autohide="true">
						   <div class="d-flex">
							   <div class="toast-body">
								   <strong>${title}</strong>: ${message}
							   </div>
							   <div class="me-2 m-auto" style="cursor: pointer; font-size: 1.25rem;" onclick="document.getElementById('${toastId}').remove()">×</div>
						   </div>
					   </div>`;
				   $('.toast-container').append(toast);
				   
				   // Initialize and show the toast using Bootstrap's JS API
				   const toastElement = document.getElementById(toastId);
				   const bootstrapToast = new bootstrap.Toast(toastElement);
				   bootstrapToast.show();
				   
				   // Reload notification counts
				   loadNotificationCount();
			   });
			   
			   connection.on("UpdateNotificationCount", function(count) {
				   window.updateNavbarNotificationCount(count);
			   });
			   
			   connection.on("UpdateChatCount", function(count) {
				   window.updateNavbarChatCount(count);
			   });
		   }
		   
		   // Function to load notification count
		   function loadNotificationCount() {
			   $.ajax({
				   url: '/Notifications/GetUnreadCount',
				   type: 'GET',
				   success: function(response) {
					   if (response.success) {
						   window.updateNavbarNotificationCount(response.unreadCount);
					   }
				   }
			   });
		   }
		   
		   // Function to load chat count
		   function loadChatCount() {
			   $.ajax({
					url: '/Chat/GetUnreadChatCount',
				   type: 'GET',
				   success: function(response) {
					   if (response.success) {
						   window.updateNavbarChatCount(response.unreadCount);
					   }
				   }
			   });
		   }
		   
		   // Function to load notifications for dropdown
		   function loadNotifications() {
			   $.ajax({
				   url: '/Notifications/GetUserNotifications',
				   type: 'GET',
				   success: function(response) {
					   if (response.success) {
						   const notifications = response.notifications;
						   let html = '';
						   
						   if (notifications.length === 0) {
							   html = `
								   <div class="text-center py-4">
									   <i class="fas fa-bell-slash fa-2x mb-2 text-muted"></i>
									   <p class="text-muted mb-0">No notifications</p>
								   </div>
							   `;
						   } else {
							   // Sort notifications by ID in descending order to ensure newest first
							   notifications.sort((a, b) => b.id - a.id);
							   
							   notifications.forEach(function(notification) {
								   // Format the date nicely
								   const date = new Date(notification.createdAt);
								   const formattedDate = date.toLocaleDateString('en-US', { 
									   month: 'short', 
									   day: 'numeric',
									   hour: '2-digit',
									   minute: '2-digit'
								   });
								   
								   // Define the notification icon based on type
								   let notificationIcon = 'bell';
								   let notificationClass = '';
								   let badgeClass = 'bg-info';
								   
								   // Check both Type and NotificationTypes for backwards compatibility
								   const notificationType = notification.notificationType || notification.type || '';

								   if (notificationType === 'Rejection' || notificationType === 'rejection') {
									   notificationIcon = 'times-circle';
									   notificationClass = 'notification-rejection';
									   badgeClass = 'bg-danger';
								   } else if (notificationType === 'Marketplace' || notificationType === 'marketplace') {
									   notificationIcon = 'store';
									   badgeClass = 'bg-success';
								   } else if (notificationType === 'Message' || notificationType === 'message') {
									   notificationIcon = 'envelope';
									   badgeClass = 'bg-primary';
								   } else if (notificationType === 'Chat' || notificationType === 'chat') {
									   notificationIcon = 'comment';
									   badgeClass = 'bg-primary';
								   } else if (notificationType === 'BusinessMessage' || notificationType === 'business_message') {
									   notificationIcon = 'comment-dollar';
									   badgeClass = 'bg-warning text-dark';
								   } else if (notificationType === 'Calendar' || notificationType === 'calendar') {
									   notificationIcon = 'calendar-alt';
									   badgeClass = 'bg-info';
									   notificationClass = 'notification-calendar';
								   }
								   
								   // Check if this notification belongs to the business owner
								   const isBusinessOwnerNotification = response.businessOwnerId && 
									   notification.userId === response.businessOwnerId;
								   
								   // Add business owner indicator if applicable
								   const businessOwnerBadge = isBusinessOwnerNotification ? 
									   `<span class="badge bg-info ms-1" title="Business Owner Notification"><i class="fas fa-building"></i></span>` : '';
								   
								   html += `
									   <a href="${notification.url}" class="dropdown-item notification-item ${notification.isRead ? 'read' : 'unread'} ${notificationClass} ${isBusinessOwnerNotification ? 'business-owner-notification' : ''}">
										   <div class="notification-icon">
											   <span class="icon-circle ${badgeClass}">
												   <i class="fas fa-${notificationIcon}"></i>
											   </span>
										   </div>
										   <div class="notification-details">
											   <h6 class="notification-title">${notification.title} ${businessOwnerBadge}</h6>
											   <p class="notification-text">${notification.message}</p>
											   <small class="notification-time">
												   <i class="fas fa-clock mr-1"></i> ${formattedDate}
											   </small>
										   </div>
									   </a>
								   `;
							   });
						   }
						   
						   $('.notification-list').html(html);
						   
						   // Update the notification counter
						   const unreadCount = notifications.filter(n => !n.isRead).length;
						   window.updateNavbarNotificationCount(unreadCount);
					   }
				   },
				   error: function(error) {
					   console.error('Error loading notifications:', error);
				   }
			   });
		   }
		   
		   // Function to mark a notification as read
		   function markNotificationAsRead(id) {
			   $.ajax({
				   url: '/Notifications/MarkAsRead',
				   type: 'POST',
				   data: { id: id },
				   headers: {
					   'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
				   },
				   success: function(response) {
					   if (response.success) {
						   // Update UI
						   $(`.notification-item[data-id="${id}"]`).removeClass('unread')
							   .find('.badge').remove();
							   
						   // Update notification count
						   loadNotificationCount();
					   }
				   }
			   });
		   }
		   
		   // Function to mark all notifications as read
		   function markAllNotificationsAsRead() {
			   $.ajax({
				   url: '/Notifications/MarkAllAsRead',
				   type: 'POST',
				   headers: {
					   'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
				   },
				   success: function(response) {
					   if (response.success) {
						   // Update UI
						   $('.notification-item').removeClass('unread')
							   .find('.badge').remove();
							   
						   // Update notification count
						   loadNotificationCount();
					   }
					}
				});
		   }
		});
	</script>

