											<li>
												<a class="dropdown-item rounded-lg px-3.5 py-2 text-sm @(ViewContext.RouteData.Values["Controller"].ToString() == "Reports" && ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")" asp-action="Index" asp-controller="Reports">
													<i class="fas fa-chart-bar me-1.5"></i>Reports
												</a>
											</li>
										}
									</ul>
								</li>
							}
							@if (User.IsInRole("BusinessOwner") || staffAccessLevel.HasFlag(StaffAccessLevel.Calendar))
							{
								<li class="nav-item">
									<a class="nav-link px-3.5 py-2 rounded-lg text-sm font-medium transition-all @(ViewContext.RouteData.Values["Controller"].ToString() == "Calendar" && ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")" asp-action="Index" asp-controller="Calendar">
										<i class="bi bi-calendar-event me-1.5 opacity-80"></i> Calendar
									</a>
								</li>
							}
							@if (User.IsInRole("BusinessOwner"))
							{
								<li class="nav-item">
									<a class="nav-link px-3.5 py-2 rounded-lg text-sm font-medium transition-all @(ViewContext.RouteData.Values["Controller"].ToString() == "Staffs" && ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")" asp-action="Index" asp-controller="Staffs">
										<i class="fas fa-users-cog me-1.5 opacity-80"></i> Staffs
									</a>
								</li>
							}
						}
					}
				</ul>
				<div class="navbar-auth-buttons d-flex align-items-center gap-2.5 ms-lg-auto">
					@if (User.Identity.IsAuthenticated)
					{
						<div class="dropdown">
							<a class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-gt-secondary/80 hover:bg-gt-secondary text-gt-navy text-sm font-semibold no-underline transition-all dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
