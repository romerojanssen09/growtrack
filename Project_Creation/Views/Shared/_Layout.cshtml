	<nav class="navbar navbar-expand-lg navbar-modern fixed-top bg-white/90 backdrop-blur-md border-b border-gt-navy/10 px-4 lg:px-8 py-2.5 transition-all duration-200">
		<div class="container-fluid max-w-[1440px] mx-auto px-2 sm:px-4">
			<a class="navbar-brand d-flex align-items-center gap-2.5 font-display font-extrabold text-xl tracking-tight text-gt-navy hover:opacity-90 transition-opacity" asp-area="" asp-controller="Home" asp-action="Index">
				<span class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-gt-accent/15 text-gt-accent shadow-xs">
					<i class="fas fa-chart-pie text-base"></i>
				</span>
				<span>Grow<span class="text-gt-accent">Track</span></span>
			</a>
			<button class="navbar-toggler p-2 rounded-lg hover:bg-gt-secondary/60 transition-colors" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
				<i class="fas fa-bars text-gt-navy text-lg"></i>
			</button>
			<div class="collapse navbar-collapse" id="navbarNav">
				<ul class="navbar-nav mx-auto d-flex align-items-lg-center justify-content-center gap-1 lg:gap-1.5 w-100">
					@if (User.Identity.IsAuthenticated)
					{
						@if (User.IsInRole("Admin"))
						{
							<li class="nav-item">
								<a class="nav-link px-3.5 py-2 rounded-lg text-sm font-medium transition-all @(ViewContext.RouteData.Values["Controller"].ToString() == "Admin" && ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")" asp-action="Index" asp-controller="Admin">
									<i class="fas fa-tachometer-alt me-1.5 opacity-80"></i> Dashboard
								</a>
							</li>
							var isAdminManagementActive = ViewContext.RouteData.Values["Controller"].ToString() == "Admin" &&
							(ViewContext.RouteData.Values["Action"].ToString() == "BOApproval" ||
							ViewContext.RouteData.Values["Action"].ToString() == "MarketplaceApproval" ||
							ViewContext.RouteData.Values["Action"].ToString() == "BusinessOwners" ||
							ViewContext.RouteData.Values["Action"].ToString() == "StaffLimits");
							<li class="nav-item dropdown">
								<a class="nav-link dropdown-toggle px-3.5 py-2 rounded-lg text-sm font-medium transition-all @(isAdminManagementActive ? "active" : "")" href="#" id="adminManagementDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
									<i class="fas fa-tasks me-1.5 opacity-80"></i> Admin Management
								</a>
								<ul class="dropdown-menu shadow-gt-lg border border-gt-navy/10 rounded-xl p-1.5" aria-labelledby="adminManagementDropdown">
									<li>
										<a class="dropdown-item rounded-lg px-3.5 py-2 text-sm @(ViewContext.RouteData.Values["Controller"].ToString() == "Admin" && ViewContext.RouteData.Values["Action"].ToString() == "BOApproval" ? "active" : "")" asp-action="BOApproval" asp-controller="Admin">
											<i class="fas fa-user-check me-1.5"></i> BO Approval
										</a>
									</li>
									<li>
										<a class="dropdown-item rounded-lg px-3.5 py-2 text-sm @(ViewContext.RouteData.Values["Controller"].ToString() == "Admin" && ViewContext.RouteData.Values["Action"].ToString() == "MarketplaceApproval" ? "active" : "")" asp-action="MarketplaceApproval" asp-controller="Admin">
											<i class="fas fa-store-alt me-1.5"></i> Marketplace Approval
										</a>
									</li>
									<li>
										<a class="dropdown-item rounded-lg px-3.5 py-2 text-sm @(ViewContext.RouteData.Values["Controller"].ToString() == "Admin" && ViewContext.RouteData.Values["Action"].ToString() == "BusinessOwners" ? "active" : "")" asp-action="BusinessOwners" asp-controller="Admin">
											<i class="fas fa-users me-1.5"></i> Business Owners
										</a>
									</li>
									<li>
										<a class="dropdown-item rounded-lg px-3.5 py-2 text-sm @(ViewContext.RouteData.Values["Controller"].ToString() == "Admin" && ViewContext.RouteData.Values["Action"].ToString() == "StaffLimits" ? "active" : "")" asp-action="StaffLimits" asp-controller="Admin">
											<i class="fas fa-users-cog me-1.5"></i> Staff Limits
										</a>
									</li>
								</ul>
							</li>
							<li class="nav-item">
								<a class="nav-link px-3.5 py-2 rounded-lg text-sm font-medium transition-all @(ViewContext.RouteData.Values["Controller"].ToString() == "Calendar" && ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")" asp-action="Index" asp-controller="Calendar">
									<i class="bi bi-calendar-event me-1.5 opacity-80"></i> Calendar
								</a>
							</li>
						}
						else
						{
							var accessLevelClaim = User.FindFirstValue("AccessLevel");
							var staffAccessLevel = !string.IsNullOrEmpty(accessLevelClaim) &&
							Enum.TryParse<StaffAccessLevel>(accessLevelClaim, out var level) ? level : StaffAccessLevel.None;

							<li class="nav-item">
								<a class="nav-link px-3.5 py-2 rounded-lg text-sm font-medium transition-all @(ViewContext.RouteData.Values["Controller"].ToString() == "Pages" && ViewContext.RouteData.Values["Action"].ToString() == "Dashboard" ? "active" : "")" asp-action="Dashboard" asp-controller="Pages">
									<i class="fas fa-tachometer-alt me-1.5 opacity-80"></i> Dashboard
								</a>
							</li>

							@if (User.IsInRole("BusinessOwner") || staffAccessLevel.HasFlag(StaffAccessLevel.Inventory) || staffAccessLevel.HasFlag(StaffAccessLevel.QuickSales))
							{
								var isInventoryActive = ViewContext.RouteData.Values["Controller"].ToString() == "Inventory1";

								<li class="nav-item dropdown">
									<a class="nav-link dropdown-toggle px-3.5 py-2 rounded-lg text-sm font-medium transition-all @(isInventoryActive ? "active" : "")" href="#" id="inventoryDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
										<i class="fas fa-boxes me-1.5 opacity-80"></i>Inventory
									</a>
									<ul class="dropdown-menu shadow-gt-lg border border-gt-navy/10 rounded-xl p-1.5" aria-labelledby="inventoryDropdown">
										@if (User.IsInRole("BusinessOwner") || staffAccessLevel.HasFlag(StaffAccessLevel.Inventory))
										{
											<li>
												<a class="dropdown-item rounded-lg px-3.5 py-2 text-sm @(ViewContext.RouteData.Values["Controller"].ToString() == "Inventory1" && ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")" asp-action="Index" asp-controller="Inventory1">
													<i class="fas fa-list me-1.5"></i>View Inventory
												</a>
											</li>
											<li>
												<a class="dropdown-item rounded-lg px-3.5 py-2 text-sm @(ViewContext.RouteData.Values["Controller"].ToString() == "Inventory1" && ViewContext.RouteData.Values["Action"].ToString() == "Create" ? "active" : "")" asp-action="Create" asp-controller="Inventory1">
													<i class="fas fa-plus-circle me-1.5"></i>Add Product
												</a>
											</li>
											<li>
												<a class="dropdown-item rounded-lg px-3.5 py-2 text-sm @(ViewContext.RouteData.Values["Controller"].ToString() == "Inventory1" && ViewContext.RouteData.Values["Action"].ToString() == "StockIn" ? "active" : "")" asp-action="StockIn" asp-controller="Inventory1">
													<i class="fas fa-arrow-down me-1.5"></i>Stock In
												</a>
											</li>
										}
										@if (User.IsInRole("BusinessOwner") || staffAccessLevel.HasFlag(StaffAccessLevel.QuickSales))
										{
											<li>
												<a class="dropdown-item rounded-lg px-3.5 py-2 text-sm @(ViewContext.RouteData.Values["Controller"].ToString() == "Inventory1" && ViewContext.RouteData.Values["Action"].ToString() == "QuickSale" ? "active" : "")" asp-action="QuickSale" asp-controller="Inventory1">
													<i class="fas fa-cash-register me-1.5"></i>Process Sale
												</a>
											</li>
										}
									</ul>
								</li>
							}
							@if (User.IsInRole("BusinessOwner") || staffAccessLevel.HasFlag(StaffAccessLevel.PublishedProducts))
							{
								<li class="nav-item">
									<a class="nav-link px-3.5 py-2 rounded-lg text-sm font-medium transition-all @(ViewContext.RouteData.Values["Controller"].ToString().Equals("Marketplace", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-action="Index" asp-controller="Marketplace">
										<i class="fas fa-store me-1.5 opacity-80"></i>Marketplace
									</a>
								</li>
								<li class="nav-item">
									<a class="nav-link px-3.5 py-2 rounded-lg text-sm font-medium transition-all @(ViewContext.RouteData.Values["Controller"].ToString().Equals("ProductOrders", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-action="Index" asp-controller="ProductOrders">
										<i class="fas fa-shopping-cart me-1.5 opacity-80"></i>Orders
									</a>
								</li>
							}
							@if (User.IsInRole("BusinessOwner") || staffAccessLevel.HasFlag(StaffAccessLevel.Leads))
							{
								var isLeadsActive = ViewContext.RouteData.Values["Controller"].ToString() == "Leads";

								<li class="nav-item">
									<a class="nav-link px-3.5 py-2 rounded-lg text-sm font-medium transition-all @(ViewContext.RouteData.Values["Controller"].ToString().Equals("Leads", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-action="Index" asp-controller="Leads">
										<i class="fas fa-user-tag me-1.5 opacity-80"></i>Leads
									</a>
								</li>
							}
							@if (User.IsInRole("BusinessOwner") || staffAccessLevel.HasFlag(StaffAccessLevel.Campaigns) || staffAccessLevel.HasFlag(StaffAccessLevel.Reports))
							{
								var isGrowthToolsActive = ViewContext.RouteData.Values["Controller"].ToString() == "Campaigns" || ViewContext.RouteData.Values["Controller"].ToString() == "Reports";
								<li class="nav-item dropdown">
									<a class="nav-link dropdown-toggle px-3.5 py-2 rounded-lg text-sm font-medium transition-all @(isGrowthToolsActive ? "active" : "")" href="#" id="growthToolsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
										<i class="fas fa-rocket me-1.5 opacity-80"></i> Growth Tools
									</a>
									<ul class="dropdown-menu shadow-gt-lg border border-gt-navy/10 rounded-xl p-1.5" aria-labelledby="growthToolsDropdown">
										@if (User.IsInRole("BusinessOwner") || staffAccessLevel.HasFlag(StaffAccessLevel.Campaigns))
										{
											<li>
												<a class="dropdown-item rounded-lg px-3.5 py-2 text-sm @(ViewContext.RouteData.Values["Controller"].ToString() == "Campaigns" && ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")" asp-action="Index" asp-controller="Campaigns">
